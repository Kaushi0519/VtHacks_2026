# Copy to .env (repo root) and fill in. NEVER commit .env.
# Backend reads this file; the simulator and frontend use the vars noted below.

# --- Core (Person 1) ---
# DATABASE_URL=sqlite:///./backend/sentinel.db      # default; Postgres: postgresql+psycopg://user:pass@localhost/sentinel
ALLOW_BACKFILL=true                                 # lets the simulator replay 7 days of history (demo seeding)
# CORS_ORIGINS=["http://localhost:3000"]

# --- GoDaddy ANS (Person 3) ---
ANS_MODE=mock                                       # mock | real   (UI shows which one is active)
ANS_BASE_URL=https://api.godaddy.com
ANS_API_KEY=                                        # GoDaddy ANS PAT (or key:secret with ANS_AUTH_SCHEME=sso-key)
ANS_AUTH_SCHEME=bearer                              # bearer | sso-key
# ANS_CACHE_TTL_SECONDS=60
# ANS_STALE_OK_SECONDS=3600

# --- Gemini (Person 3) ---
GEMINI_MODE=mock                                    # mock (rule-based fallback) | real
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TIMEOUT_SECONDS=8

# --- Simulator (Ishan) ---
# SENTINEL_URL=http://localhost:8000

# --- Frontend: put these in frontend/.env.local (see frontend/.env.local.example) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SIM_URL=http://localhost:8001
